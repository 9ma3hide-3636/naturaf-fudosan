# ─────────────────────────────────────────────────────
# NATURAF不動産支部 AIシステム Phase1 — 環境変数テンプレート
# このファイルを .env にコピーして値を設定してください
# cp .env.example .env
# ─────────────────────────────────────────────────────

# 送信元 Gmail アドレス
GMAIL_ADDRESS=your_address@gmail.com

# Gmail アプリパスワード（16桁）
# 取得手順:
#   1. Googleアカウント → セキュリティ → 2段階認証を有効化
#   2. セキュリティ → アプリパスワード → 「メール」「その他」で生成
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# 通知先メールアドレス（省略時は GMAIL_ADDRESS 宛に届く）
NOTIFY_TO=your_address@gmail.com
